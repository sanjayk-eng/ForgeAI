APP_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/forgeai?sslmode=disable
JWT_SECRET=forgeai-dev-secret-change-me-1234567890
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SOURCE=true

# OpenAI-compatible coding agent. Keep the API key server-side.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:5173/auth/callback