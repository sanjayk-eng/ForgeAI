# ForgeAI Sandbox Image - Frontend Development Environment
# Lightweight image for running user code in isolated Docker containers

FROM node:20-alpine

# Install git and bash for version control and shell operations
RUN apk add --no-cache bash git

# Install only essential frontend tools
RUN npm install --global typescript@latest

# Set up environment variables for non-root user
ENV HOME=/tmp/.home \
    npm_config_cache=/tmp/npm-cache \
    TMPDIR=/tmp

WORKDIR /workspace
